<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette (owner-approved mockup layout-v2.html) -->
    <SolidColorBrush x:Key="BgBrush" Color="#14161A" />
    <SolidColorBrush x:Key="BarBrush" Color="#0E1013" />
    <SolidColorBrush x:Key="CardBrush" Color="#1C1F24" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#22262C" />
    <SolidColorBrush x:Key="LineBrush" Color="#2A2D33" />
    <SolidColorBrush x:Key="LineHoverBrush" Color="#3A3D44" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E3DC" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8B8F97" />
    <SolidColorBrush x:Key="GoldBrush" Color="#D9B76A" />
    <SolidColorBrush x:Key="GoldHoverBrush" Color="#E6C985" />
    <SolidColorBrush x:Key="GreenBrush" Color="#4F8A4A" />
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#5E9E58" />
    <SolidColorBrush x:Key="PillTextBrush" Color="#9FD29A" />
    <SolidColorBrush x:Key="AmberBrush" Color="#E8B04B" />
    <SolidColorBrush x:Key="AmberBgBrush" Color="#33291A" />
    <SolidColorBrush x:Key="InkBrush" Color="#14161A" />

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Keyboard focus ring -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="6" RadiusY="6" Stroke="{StaticResource GoldBrush}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Icon" Value="pack://application:,,,/app.ico" />
    </Style>

    <!-- Buttons: gold primary by default -->
    <Style x:Key="ButtonBase" TargetType="ButtonBase">
        <Setter Property="Background" Value="{StaticResource GoldBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Tag" Value="{StaticResource GoldHoverBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource LineBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Tag" Value="{StaticResource LineHoverBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource GreenBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Tag" Value="{StaticResource GreenHoverBrush}" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="Tag" Value="{StaticResource RaisedBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="6,6" />
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Tag" Value="{StaticResource RaisedBrush}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <!-- Tabs are radio buttons in the top bar -->
    <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Margin="0,0,22,0">
                        <ContentPresenter Margin="0,14" VerticalAlignment="Center" />
                        <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Background="{StaticResource GoldBrush}" Visibility="Hidden" CornerRadius="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off switch (CheckBox keeps the toggle semantics for screen readers) -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border x:Name="Track" Width="34" Height="18" CornerRadius="9" Background="{StaticResource LineHoverBrush}">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="2,0" Fill="White" HorizontalAlignment="Left" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource GreenBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LineBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Warning" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AmberBgBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineHoverBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource GoldBrush}" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineHoverBrush}" />
    </Style>

    <!-- Card progress bar -->
    <Style x:Key="CardProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{StaticResource LineBrush}" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{StaticResource GreenBrush}" CornerRadius="3" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim scrollbar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="T" Margin="2" CornerRadius="3" Background="{StaticResource LineHoverBrush}" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="T" Property="Background" Value="{StaticResource MutedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus (+ Add mod) -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineHoverBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Width="270">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,8">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource LineBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineHoverBrush}" BorderThickness="1" CornerRadius="4">
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="10,6,30,6" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineHoverBrush}" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="10,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource LineBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card container -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="300" />
        <Setter Property="Margin" Value="0,0,16,16" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource LineHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Clickable 16:9 thumbnail that opens the details window -->
    <Style x:Key="ThumbButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Height="168">
                        <Border CornerRadius="7,7,0,0" Background="{Binding Placeholder}">
                            <TextBlock Text="{Binding Name}" Foreground="#F3E6C8" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                       VerticalAlignment="Bottom" Margin="12,0,12,10" />
                        </Border>
                        <Border CornerRadius="7,7,0,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="Hover" CornerRadius="7,7,0,0" Background="#18FFFFFF" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary card action: gold, green for updates, ghost when there's nothing to do -->
    <Style x:Key="CardPrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsUpdate}" Value="True">
                <Setter Property="Background" Value="{StaticResource GreenBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Tag" Value="{StaticResource GreenHoverBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PrimaryActionText}" Value="Installed">
                <Setter Property="Background" Value="{StaticResource LineBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ModCard">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Button Style="{StaticResource ThumbButton}" Command="{Binding DetailsCommand}"
                        AutomationProperties.Name="{Binding Name, StringFormat=Details for {0}}" ToolTip="Details" />
                <StackPanel Margin="14,12,14,8">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Tag}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <Border Style="{StaticResource Warning}" Visibility="{Binding HasBuildWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BuildWarning}" Foreground="{StaticResource AmberBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <Border Style="{StaticResource Warning}" Visibility="{Binding HasOverlapWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding OverlapWarning}" Foreground="{StaticResource AmberBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <Border Style="{StaticResource Warning}" Visibility="{Binding HasNexusUpdate, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding NexusUpdateText}" Foreground="{StaticResource AmberBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <DockPanel Margin="0,10,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Padding="6" Margin="8,0,0,0"
                                Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel download" ToolTip="Cancel" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <ProgressBar Style="{StaticResource CardProgress}" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"
                                     AutomationProperties.Name="Download progress" />
                    </DockPanel>
                    <TextBlock Text="{Binding FilesText}" Style="{StaticResource Muted}" FontFamily="Consolas" Margin="0,8,0,0"
                               Visibility="{Binding IsUnmanaged, Converter={StaticResource BoolToVis}}" />
                    <DockPanel Margin="0,12,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Top" Margin="8,5,0,0"
                                  Visibility="{Binding ShowToggle, Converter={StaticResource BoolToVis}}"
                                  IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                                  AutomationProperties.Name="{Binding Name, StringFormat=Enable {0}}" ToolTip="Enabled in the game" />
                        <WrapPanel>
                            <WrapPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Margin" Value="0,0,8,6" />
                                </Style>
                            </WrapPanel.Resources>
                            <Button Style="{StaticResource CardPrimaryButton}" Content="{Binding PrimaryActionText}" Command="{Binding PrimaryCommand}"
                                    Visibility="{Binding ShowPrimary, Converter={StaticResource BoolToVis}}" Margin="0,0,8,6" />
                            <Button Content="{Binding ManageOfficialText}" Command="{Binding ManageOfficialCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"
                                    Visibility="{Binding HasManageOfficial, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Manage as new mod" Command="{Binding ManageNewCommand}"
                                    Visibility="{Binding HasManageNew, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource CardPrimaryButton}" Content="Apply downloaded update…" Command="{Binding ApplyUpdateCommand}" Margin="0,0,8,6"
                                    Visibility="{Binding HasNexusUpdate, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Pick the zip or .pak you downloaded from Nexus; it replaces this mod's files" />
                            <Button Content="Uninstall" Command="{Binding UninstallCommand}"
                                    Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Link Nexus page" Command="{Binding LinkNexusCommand}"
                                    Visibility="{Binding CanLinkNexus, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Paste the mod's Nexus link to get told when a new version is out" />
                            <Button Style="{StaticResource LinkButton}" Content="View on Nexus" Command="{Binding NexusCommand}" Margin="0,0,8,6"
                                    Visibility="{Binding HasNexus, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource LinkButton}" Content="Unlink" Command="{Binding UnlinkNexusCommand}" Margin="0,0,0,6"
                                    Visibility="{Binding IsNexusLinked, Converter={StaticResource BoolToVis}}" ToolTip="Stop checking Nexus for this mod" />
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="CardPanel">
        <WrapPanel />
    </ItemsPanelTemplate>

</ResourceDictionary>
