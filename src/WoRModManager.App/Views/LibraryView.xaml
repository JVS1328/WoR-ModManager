<UserControl x:Class="WoRModManager.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="24,20,24,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh" ToolTip="Check GitHub for new mods and updates">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="My Library" Style="{StaticResource Heading}" />
                <TextBlock Text="Everything installed in the game: Red's Corner mods, mods you added, and files the manager doesn't own yet." Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Cards" ItemsSource="{Binding Library}" ItemTemplate="{StaticResource ModCard}"
                          ItemsPanel="{StaticResource CardPanel}" Focusable="False" Margin="24,0,8,8" />
        </ScrollViewer>
        <TextBlock Grid.Row="1" FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="24,40"
                   Text="Nothing installed yet. Install one from Red's Corner, or use + Add mod.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasItems, ElementName=Cards}" Value="False" />
                                <Condition Binding="{Binding IsBusy}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
