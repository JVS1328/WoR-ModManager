<Window x:Class="WoRModManager.App.Views.CustomizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="{Binding Title}"
        Width="900" Height="600" MinWidth="640" MinHeight="420" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,20,0">
            <TextBlock DockPanel.Dock="Top" Text="Search uniforms" Style="{StaticResource Muted}" Margin="0,0,0,4" />
            <TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                     AutomationProperties.Name="Search uniforms" />
            <TextBlock DockPanel.Dock="Bottom" Text="● customized in this profile" Style="{StaticResource Muted}" Margin="0,6,0,0" />
            <ListBox ItemsSource="{Binding Uniforms}" SelectedItem="{Binding SelectedUniform}" DisplayMemberPath="Text"
                     VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Uniforms" />
        </DockPanel>

        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedUniform.Label}" Style="{StaticResource Heading}" TextWrapping="Wrap" />
            <Border DockPanel.Dock="Top" Style="{StaticResource Warning}" Visibility="{Binding HasUnknown, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Some items in this uniform come from a mod that isn't enabled; they'll be kept." Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
            </Border>
            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <ItemsControl ItemsSource="{Binding SlotRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedValuePath="Id" SelectedValue="{Binding SelectedId}" DisplayMemberPath="Name"
                                          IsEnabled="{Binding IsEditable}" AutomationProperties.Name="{Binding Label}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Reset to game default" Command="{Binding ResetCommand}"
                    ToolTip="Forget this uniform's changes so the game uses its own default" />
            <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveCommand}" Margin="8,0,0,0" IsDefault="True" />
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Cancel" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
