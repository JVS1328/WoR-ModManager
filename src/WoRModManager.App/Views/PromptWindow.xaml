<Window x:Class="WoRModManager.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="War of Rights Mod Manager"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="14" LineHeight="20" />
        <TextBox x:Name="Input" Margin="0,14,0,0" Visibility="Collapsed" AutomationProperties.Name="Name" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="OkButton" IsDefault="True" Click="Ok_Click" MinWidth="80" />
            <Button x:Name="CancelButton" IsCancel="True" Style="{StaticResource GhostButton}" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
