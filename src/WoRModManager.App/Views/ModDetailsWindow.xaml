<Window x:Class="WoRModManager.App.Views.ModDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="{Binding Name}"
        Width="640" Height="640" MinWidth="420" MinHeight="400" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Height="220">
            <Border Background="{Binding Placeholder}">
                <TextBlock Text="{Binding Name}" Foreground="#F3E6C8" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="24,0,24,16" />
            </Border>
            <Border>
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,18,24,18">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding GameBuildText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <Border Style="{StaticResource Warning}" Visibility="{Binding HasBuildWarning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding BuildWarning}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource Warning}" Visibility="{Binding HasOverlapWarning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding OverlapWarning}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="About" FontWeight="SemiBold" Margin="0,20,0,6" />
                <!-- GitHub text is shown as plain text only -->
                <TextBox Text="{Binding Blurb, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                         AutomationProperties.Name="Description" />

                <StackPanel Visibility="{Binding HasHistorySection, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Version history" FontWeight="SemiBold" Margin="0,20,0,6" />
                    <TextBlock Text="{Binding HistoryStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Visibility="{Binding HasHistoryStatus, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding History}" Focusable="False" AutomationProperties.Name="Version history">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Header}" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                             Padding="10,8" AutomationProperties.Name="{Binding Header}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Style="{StaticResource GhostButton}" MinWidth="80" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Uninstall" Style="{StaticResource GhostButton}" Command="{Binding UninstallCommand}" Click="Uninstall_Click"
                        Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource LinkButton}" Content="View on Nexus" Command="{Binding NexusCommand}"
                        Visibility="{Binding HasNexus, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
