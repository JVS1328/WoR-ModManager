<Window x:Class="WoRModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WoRModManager.App.Views"
        Style="{StaticResource AppWindow}" Title="War of Rights Mod Manager"
        Width="1040" Height="720" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Manager update banner -->
        <Border Grid.Row="0" Background="#2E2715" BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,0,0,1" Padding="20,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ManagerUpdate}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ManagerUpdateText}" VerticalAlignment="Center" Foreground="{StaticResource GoldBrush}" />
                <Button Content="Update now" Command="{Binding UpdateManagerCommand}" Margin="10,0,0,0" Padding="10,4" />
            </StackPanel>
        </Border>

        <!-- Top bar -->
        <Border Grid.Row="1" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="WoR MOD MANAGER" Foreground="{StaticResource GoldBrush}" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,32,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Margin="0,0,12,0" ToolTip="Installed War of Rights build (from Steam)">
                        <TextBlock Text="{Binding GameBuild}" Foreground="{StaticResource PillTextBrush}" FontSize="11" />
                    </Border>
                    <Button x:Name="AddModButton" Content="+ Add mod ▾" Click="AddMod_Click" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Add mod">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="AddFromFile_Click" AutomationProperties.Name="From a zip or .pak">
                                    <MenuItem.Header>
                                        <StackPanel>
                                            <TextBlock Text="From a zip or .pak" FontWeight="SemiBold" />
                                            <TextBlock Text="A file you already downloaded (or drag it onto the window)" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" Margin="4,0,0,0"
                            AutomationProperties.Name="Settings" ToolTip="Settings" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="OfficialTab" Style="{StaticResource TabButton}" Content="Official Mods" IsChecked="True" GroupName="Tabs" />
                    <RadioButton x:Name="LibraryTab" Style="{StaticResource TabButton}" Content="My Library" GroupName="Tabs" />
                    <RadioButton x:Name="ReShadeTab" Style="{StaticResource TabButton}" Content="ReShade" GroupName="Tabs" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="2" Height="2" IsIndeterminate="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource GoldBrush}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Working" />

        <Border Grid.Row="3" Background="{StaticResource AmberBgBrush}" Padding="20,8"
                Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Offline / GitHub busy — showing last known list" Foreground="{StaticResource AmberBrush}" />
        </Border>

        <Grid Grid.Row="4">
            <views:OfficialModsView Visibility="{Binding IsChecked, ElementName=OfficialTab, Converter={StaticResource BoolToVis}}" />
            <views:LibraryView Visibility="{Binding IsChecked, ElementName=LibraryTab, Converter={StaticResource BoolToVis}}" />
            <views:ReShadeView DataContext="{Binding ReShade}" Visibility="{Binding IsChecked, ElementName=ReShadeTab, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Status line -->
        <Border Grid.Row="5" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" />
        </Border>
    </Grid>
</Window>
